#!name=pilipili签到
#!desc=自用 Emby 签到脚本

[MITM]
hostname = %APPEND% mambo-hachimi.biliblili.uk

[Script]
pilipili 捕获令牌 = type=http-response,pattern=^https://mambo-hachimi\.biliblili\.uk/api/auth/(login|refresh-token),requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/yeah1z1/pilipili-checkin/main/scripts/capture.js,script-update-interval=86400,timeout=15
pilipili 每日签到 = type=cron,cronexp="5 0 * * *",wake-system=true,script-path=https://raw.githubusercontent.com/yeah1z1/pilipili-checkin/main/scripts/checkin.js,script-update-interval=86400,timeout=60
pilipili 手动签到 = type=generic,script-path=https://raw.githubusercontent.com/yeah1z1/pilipili-checkin/main/scripts/checkin.js,script-update-interval=86400,timeout=60
